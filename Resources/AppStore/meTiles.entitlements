<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- meTiles, the Mac App Store edition of MacTiles. Scripts/appstore.sh adds the team and
         application identifiers from your provisioning profile when it signs. -->

    <!-- Required for the Mac App Store. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Weather, news feeds, web tile icons and your homelab services. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- The Calendar live tile (asks first). -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>

    <!-- The Photos live tile's default folder, ~/Pictures (read only). -->
    <key>com.apple.security.assets.pictures.read-only</key>
    <true/>

    <!-- Files and folders you choose: wallpapers, a Photos folder, Import Layout… (read only),
         and remembering a chosen Photos folder across restarts. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
