<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>MacTiles</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.mactiles.MacTiles</string>
    <key>CFBundleName</key>
    <string>MacTiles</string>
    <key>CFBundleDisplayName</key>
    <string>MacTiles</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.15.0</string>
    <key>CFBundleVersion</key>
    <string>14</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>MacTiles shows your next events on the Calendar live tile.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>MacTiles shows your next events on the Calendar live tile.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>MacTiles connects to the services on your network that you add in Settings → Integrations, like Plex, Pi-hole and Home Assistant, to show them on your tiles.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Homelab services are often plain HTTP, on an IP address or a home DNS name
             (http://192.168.1.10:8989, http://nas.lan:8096). Only addresses you type in are
             contacted. Don't add NSAllowsLocalNetworking here: when it's present, macOS ignores
             NSAllowsArbitraryLoads and blocks plain HTTP to names like nas.lan. -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 MacTiles contributors. MIT License.</string>
</dict>
</plist>
